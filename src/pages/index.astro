---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <meta name="description" content="" />
    <title>skull</title>
    <style is:global>
      :root {
        /* Space-separated RGB components used by rgb(var(--hud-rgb) / alpha).
           Updated from skull.ts on click to match the current skull color. */
        --hud-rgb: 0 255 200;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        height: 100%;
        width: 100%;
        background: #000;
        color: rgb(var(--hud-rgb));
        font-family: ui-monospace, "Courier New", monospace;
        overflow: hidden;
        overscroll-behavior: none;
      }
      canvas#skull-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        display: block;
      }
      #hud {
        position: fixed;
        inset: 0;
        pointer-events: none;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      #hud a { pointer-events: auto; color: inherit; }
      #hud .hud-corner {
        position: absolute;
        padding: 14px 18px;
        color: rgb(var(--hud-rgb));
        text-shadow: 0 0 6px rgb(var(--hud-rgb) / 0.6);
        white-space: pre;
        line-height: 1.55;
      }
      #hud .hud-tl { top: 32px; left: 0; text-align: left; }
      #hud .hud-tr { top: 32px; right: 0; text-align: right; }
      #hud .hud-bl { bottom: 32px; left: 0; }
      #hud .hud-br { bottom: 32px; right: 0; text-align: right; }
      #hud .hud-bar {
        position: absolute;
        left: 0; right: 0;
        height: 24px;
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 0 18px;
        font-size: 10px;
        color: rgb(var(--hud-rgb));
      }
      #hud .hud-bar.hud-top { top: 0; border-bottom: 1px solid rgb(var(--hud-rgb) / 0.25); }
      #hud .hud-bar.hud-bottom {
        bottom: 0;
        border-top: 1px solid rgb(var(--hud-rgb) / 0.25);
        justify-content: flex-end;
      }
    </style>
  </head>
  <body>
    <canvas id="skull-canvas"></canvas>
    <div id="hud" aria-hidden="true">
      <div class="hud-corner hud-tl" data-corner="tl"></div>
      <div class="hud-corner hud-tr" data-corner="tr"></div>
      <div class="hud-corner hud-bl" data-corner="bl"></div>
      <div class="hud-corner hud-br" data-corner="br"></div>
      <div class="hud-bar hud-top"></div>
      <div class="hud-bar hud-bottom">
        <a href="mailto:oriole-quod0p@icloud.com">email</a>
      </div>
    </div>
    <script>
      import '../skull/skull.ts';
    </script>
  </body>
</html>
